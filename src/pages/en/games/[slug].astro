---
import Game from '../../../views/Game.astro';
import { games, type Game as GameData } from '../../../data';

export function getStaticPaths() {
  return games.map((game) => ({ params: { slug: game.slug }, props: { game } }));
}

const { game } = Astro.props as { game: GameData };
---

<Game lang="en" game={game} />

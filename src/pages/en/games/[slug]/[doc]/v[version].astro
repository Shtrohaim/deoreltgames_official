---
import LegalDoc from '../../../../../views/LegalDoc.astro';
import { games, type Game } from '../../../../../data';
import { docsFor, archivedVersions, type DocId } from '../../../../../legal';

export function getStaticPaths() {
  return games.flatMap((game) =>
    docsFor(game.slug).flatMap((doc) =>
      archivedVersions(game.slug, doc).map(({ version }) => ({
        params: { slug: game.slug, doc, version: String(version) },
        props: { game, doc, version },
      })),
    ),
  );
}

const { game, doc, version } = Astro.props as { game: Game; doc: DocId; version: number };
---

<LegalDoc lang="en" game={game} doc={doc} version={version} />

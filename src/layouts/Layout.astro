---
// Fonts are bundled with the site so no visitor data goes to Google Fonts.
import '@fontsource/russo-one/400.css';
import '@fontsource/manrope/400.css';
import '@fontsource/manrope/600.css';
import '@fontsource/manrope/800.css';
import '../styles/global.css';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import { t, href, asset, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  /** Path without base and language prefix, e.g. "/" or "/games/x/". */
  path: string;
  title?: string;
  description?: string;
  /** Social preview image, path in /public. */
  image?: string;
}

const { lang, path, title, description, image } = Astro.props;
const fullTitle = title ? `${title} — DeorelTGames` : 'DeorelTGames — Mobile Games Development';
const desc = description ?? t[lang].meta.description;
const abs = (l: Lang) => new URL(href(l, path), Astro.site).href;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={desc} />
    <meta name="theme-color" content="#0a0706" />
    <link rel="canonical" href={abs(lang)} />
    <link rel="alternate" hreflang="ru" href={abs('ru')} />
    <link rel="alternate" hreflang="en" href={abs('en')} />
    <link rel="alternate" hreflang="x-default" href={abs('ru')} />
    <link rel="icon" type="image/svg+xml" href={asset('/favicon.svg')} />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content="DeorelTGames" />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={desc} />
    <meta property="og:url" content={abs(lang)} />
    {image && <meta property="og:image" content={new URL(asset(image), Astro.site).href} />}
    {image && <meta name="twitter:card" content="summary_large_image" />}
    <meta property="og:locale" content={lang === 'ru' ? 'ru_RU' : 'en_US'} />
  </head>
  <body>
    <Header lang={lang} path={path} />
    <main>
      <slot />
    </main>
    <Footer lang={lang} />
    <script>
      // Assemble mailto links at runtime to keep the address away from simple scrapers.
      document.querySelectorAll<HTMLAnchorElement>('a[data-mail-user]').forEach((a) => {
        const addr = `${a.dataset.mailUser}@${a.dataset.mailDomain}`;
        a.href = `mailto:${addr}`;
        const label = a.querySelector('[data-mail-label]');
        if (label) label.textContent = addr;
      });
    </script>
  </body>
</html>

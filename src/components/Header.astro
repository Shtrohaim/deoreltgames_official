---
import Mark from './Mark.astro';
import { t, href, type Lang } from '../i18n';

interface Props {
  lang: Lang;
  path: string;
}
const { lang, path } = Astro.props;
const s = t[lang];
const other: Lang = lang === 'ru' ? 'en' : 'ru';
const home = href(lang, '/');
---

<header class="header">
  <div class="container bar">
    <a class="brand" href={home} aria-label="DeorelTGames">
      <Mark size={40} />
      <span class="name">Deorel<span class="fire-text">T</span>Games</span>
    </a>
    <nav class="nav" aria-label="Main">
      <a href={`${home}#games`}>{s.nav.games}</a>
      <a href={href(lang, '/news/')}>{s.nav.news}</a>
      <a href={`${home}#about`}>{s.nav.about}</a>
      <a href={`${home}#contacts`}>{s.nav.contacts}</a>
    </nav>
    <a class="lang" href={href(other, path)} hreflang={other} lang={other} title={s.langSwitchLabel}>
      {s.langSwitch}
    </a>
  </div>
</header>

<style>
  .header {
    position: sticky;
    top: 0;
    z-index: 50;
    background: rgb(10 7 6 / 0.78);
    backdrop-filter: blur(12px);
    -webkit-backdrop-filter: blur(12px);
    border-bottom: 1px solid rgb(255 120 0 / 0.14);
  }

  .bar {
    display: flex;
    align-items: center;
    gap: 16px;
    min-height: 68px;
    flex-wrap: wrap;
  }

  .brand {
    display: flex;
    align-items: center;
    gap: 12px;
    text-decoration: none;
    margin-right: auto;
  }

  .name {
    font-family: var(--font-display);
    font-size: 20px;
    letter-spacing: 0.02em;
  }

  .nav {
    display: flex;
    gap: 4px;
  }

  .nav a {
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    color: var(--muted);
    padding: 8px 12px;
    border-radius: 8px;
    transition: color 0.15s ease, background 0.15s ease;
  }

  .nav a:hover {
    color: var(--text);
    background: rgb(255 255 255 / 0.05);
  }

  .lang {
    font-family: var(--font-display);
    font-size: 14px;
    text-decoration: none;
    padding: 7px 12px;
    border-radius: 8px;
    box-shadow: inset 0 0 0 1px var(--line);
    color: var(--fire-3);
  }

  .lang:hover {
    box-shadow: inset 0 0 0 1px var(--fire-2);
  }

  @media (max-width: 719px) {
    .bar {
      padding-top: 10px;
      padding-bottom: 6px;
      gap: 8px 12px;
    }
    .name {
      font-size: 17px;
    }
    .nav {
      order: 3;
      width: 100%;
      margin: 0 -12px;
    }
    .nav a {
      font-size: 14px;
    }
  }
</style>

---
interface Props {
  name: 'youtube' | 'tiktok' | 'mail' | 'rustore' | 'google-play' | 'arrow-left' | 'play';
}
const { name } = Astro.props;
---

<svg viewBox="0 0 24 24" aria-hidden="true" fill="currentColor">
  {name === 'youtube' && (
    <path d="M23 7.2a3 3 0 0 0-2.1-2.1C19 4.6 12 4.6 12 4.6s-7 0-8.9.5A3 3 0 0 0 1 7.2 31 31 0 0 0 .5 12 31 31 0 0 0 1 16.8a3 3 0 0 0 2.1 2.1c1.9.5 8.9.5 8.9.5s7 0 8.9-.5a3 3 0 0 0 2.1-2.1 31 31 0 0 0 .5-4.8 31 31 0 0 0-.5-4.8ZM9.7 15.1V8.9l5.8 3.1-5.8 3.1Z" />
  )}
  {name === 'tiktok' && (
    <path d="M16.6 2.5c.3 2.3 1.7 3.9 4.1 4.1v3.2c-1.5.1-2.9-.4-4.1-1.2v6.6a5.9 5.9 0 1 1-5.9-5.9l.9.1v3.3a2.6 2.6 0 1 0 1.8 2.5V2.5h3.2Z" />
  )}
  {name === 'mail' && (
    <path d="M3 5h18a1 1 0 0 1 1 1v12a1 1 0 0 1-1 1H3a1 1 0 0 1-1-1V6a1 1 0 0 1 1-1Zm1 2.4V17h16V7.4l-8 5.3-8-5.3ZM5.3 7 12 11.4 18.7 7H5.3Z" />
  )}
  {name === 'rustore' && (
    <path d="M4.5 3h15A1.5 1.5 0 0 1 21 4.5v15a1.5 1.5 0 0 1-1.5 1.5h-15A1.5 1.5 0 0 1 3 19.5v-15A1.5 1.5 0 0 1 4.5 3Zm3 4v10l3-1.2V9.6l3 1v6.6l3 1V8.6L10.6 6.7 7.5 7Z" />
  )}
  {name === 'google-play' && <path d="M4 2.8 13.6 12 4 21.2a1.4 1.4 0 0 1-.5-1.1V3.9c0-.4.2-.8.5-1.1Zm10.7 10.3 2.4 2.4-11 6.3 8.6-8.7Zm3.6-3.6 2.9 1.7c.9.5.9 1.7 0 2.2l-2.9 1.7-2.6-2.6 2.6-3Zm-13.2-7 11 6.3-2.4 2.4-8.6-8.7Z" />}
  {name === 'arrow-left' && <path d="M10.7 5.3 4 12l6.7 6.7 1.4-1.4L7.8 13H20v-2H7.8l4.3-4.3-1.4-1.4Z" />}
  {name === 'play' && <path d="M8 5v14l11-7L8 5Z" />}
</svg>

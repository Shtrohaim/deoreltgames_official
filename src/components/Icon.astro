        <path d="M18.816 26.029a.73.73 0 0 1-.533-.663l-.304-8.954c-.088-1.185-.967-2.127-1.886-2.405a.11.11 0 0 0-.113.191c.227.176.851.749.851 1.738l-.002 9.589 1.987.504Zm6.567-2.702a.73.73 0 0 1-.534-.66l-.303-8.953c-.088-1.185-.968-2.127-1.887-2.405a.11.11 0 0 0-.113.191c.227.176.852.749.852 1.738l-.002 9.592 1.987.497Z" fill="white" />
      </mask>
      <rect width="36" height="36" rx="12" mask="url(#rustore-cut)" />
    </g>
  )}
  {name === 'google-play' && <path d="M4 2.8 13.6 12 4 21.2a1.4 1.4 0 0 1-.5-1.1V3.9c0-.4.2-.8.5-1.1Zm10.7 10.3 2.4 2.4-11 6.3 8.6-8.7Zm3.6-3.6 2.9 1.7c.9.5.9 1.7 0 2.2l-2.9 1.7-2.6-2.6 2.6-3Zm-13.2-7 11 6.3-2.4 2.4-8.6-8.7Z" />}

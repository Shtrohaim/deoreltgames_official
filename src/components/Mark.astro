---
// Studio monogram drawn in code until the logo files are added.
interface Props {
  size?: number | string;
}
const { size = 40 } = Astro.props;
const s = typeof size === 'number' ? `${size}px` : size;
---

<span class="mark" style={`--s:${s}`} aria-hidden="true">
  <span>DT</span>
</span>

<style>
  .mark {
    position: relative;
    display: inline-grid;
    place-items: center;
    width: var(--s);
    height: var(--s);
    border-radius: 50%;
    background: radial-gradient(circle at 50% 40%, #241812, #0b0806 70%);
    box-shadow:
      inset 0 0 0 calc(var(--s) * 0.06) #3b3430,
      0 0 0 calc(var(--s) * 0.025) rgb(255 120 0 / 0.6),
      0 0 calc(var(--s) * 0.5) rgb(255 100 0 / 0.35);
    flex: none;
  }

  .mark span {
    font-family: var(--font-display);
    font-style: italic;
    font-size: calc(var(--s) * 0.48);
    line-height: 1;
    letter-spacing: -0.06em;
    /* Room for the italic overhang, otherwise background-clip cuts the T. */
    padding: 0 0.14em 0 0.04em;
    background: var(--fire);
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    filter: drop-shadow(0 calc(var(--s) * 0.02) 0 #3a1500);
    transform: translateX(-3%);
  }
</style>

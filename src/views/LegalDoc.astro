---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { t, href, type Lang } from '../i18n';
import type { Game } from '../data';
import { getDoc, type DocId } from '../legal';

interface Props {
  lang: Lang;
  /** Omit for documents about the site itself (content/legal/site/). */
  game?: Game;
  doc: DocId;
}
const { lang, game, doc } = Astro.props;
const s = t[lang];
const legal = getDoc(game?.slug ?? 'site', doc, lang)!;
const title = game ? s.legal[doc] : s.legal.sitePrivacy;
const path = game ? `/games/${game.slug}/${doc}/` : `/${doc}/`;
const back = game
  ? { href: href(lang, `/games/${game.slug}/`), label: s.legal.backToGame }
  : { href: href(lang, '/legal/'), label: s.legal.title };
---

<Layout lang={lang} path={path} title={game ? `${title} — ${game.title}` : title}>
  <article class="legal">
    <div class="container">
      <a class="back" href={back.href}><Icon name="arrow-left" />{back.label}</a>
      <header>
        <span class="badge">{game?.title ?? 'DeorelTGames'}</span>
        <h1>{title}</h1>
        {!legal.native && <p class="note">{s.legal.ruOnly}</p>}
      </header>
      <div class="prose" lang={legal.native ? lang : 'ru'} set:html={legal.html} />
    </div>
  </article>
</Layout>

<style>
  .legal {
    padding: 32px 0 96px;
    background:
      radial-gradient(ellipse 50% 30% at 85% 0%, rgb(255 90 0 / 0.16), transparent 70%),
      var(--bg);
  }

  .legal .container {
    max-width: 840px;
  }

  .back {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    color: var(--muted);
    text-decoration: none;
    font-weight: 600;
    font-size: 15px;
    margin-bottom: 32px;
  }

  .back:hover {
    color: var(--text);
  }

  .back :global(svg) {
    width: 18px;
    height: 18px;
  }

  header {
    margin-bottom: 36px;
  }

  h1 {
    font-size: clamp(30px, 5.5vw, 48px);
    margin: 16px 0 0;
  }

  .note {
    margin: 16px 0 0;
    color: var(--fire-3);
    font-size: 15px;
  }

  /* Document body comes from content/legal/*.html */
  .prose {
    color: #ddd2ca;
    font-size: 16px;
    line-height: 1.7;
    overflow-wrap: anywhere;
  }

  .prose :global(h2) {
    display: flex;
    align-items: center;
    gap: 12px;
    font-size: clamp(21px, 3vw, 26px);
    color: var(--text);
    margin: 44px 0 14px;
  }

  .prose :global(h2)::before {
    content: '';
    width: 9px;
    height: 0.85em;
    background: var(--fire);
    transform: skewX(-18deg);
    flex: none;
  }

  .prose :global(h3) {
    font-size: 18px;
    color: var(--fire-3);
    margin: 28px 0 10px;
  }

  .prose :global(p) {
    margin: 0 0 14px;
  }

  .prose :global(strong) {
    color: var(--text);
  }

  .prose :global(a) {
    color: var(--fire-2);
    text-decoration-thickness: 1px;
    text-underline-offset: 3px;
  }

  .prose :global(a:hover) {
    color: var(--fire-3);
  }

  .prose :global(ul) {
    list-style: none;
    padding: 0;
    margin: 0 0 16px;
  }

  .prose :global(li) {
    position: relative;
    padding-left: 22px;
    margin-bottom: 6px;
  }

  .prose :global(li)::before {
    content: '';
    position: absolute;
    left: 4px;
    top: 0.72em;
    width: 7px;
    height: 7px;
    background: var(--fire-2);
    transform: rotate(45deg);
  }

  .prose :global(.meta) {
    display: grid;
    gap: 4px;
    padding: 20px 24px;
    margin-bottom: 32px;
    border-radius: var(--radius);
    background: var(--surface);
    box-shadow: inset 0 0 0 1px var(--line);
    border-left: 3px solid var(--fire-2);
  }

  .prose :global(.meta p) {
    margin: 0;
  }
</style>

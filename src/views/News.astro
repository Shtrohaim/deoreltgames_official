---
import Layout from '../layouts/Layout.astro';
import { t, href, asset, type Lang } from '../i18n';
import { news, games } from '../data';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const s = t[lang];
const gameTitle = (slug?: string) => games.find((g) => g.slug === slug)?.title;
---

<Layout lang={lang} path="/news/" title={s.news.title} description={s.news.lead}>
  <section class="section">
    <div class="container narrow">
      <div class="section-title"><h1>{s.news.title}</h1></div>
      <p class="lead">{s.news.lead}</p>
      {news.map((n) => (
        <article class="post" id={n.slug}>
          {n.image && (
            <img src={asset(n.image.replace('{lang}', lang))} alt="" width="1280" height="720" loading="lazy" />
          )}
          <div class="body">
            <div class="meta">
              <time datetime={n.date}>{s.news.date(n.date)}</time>
              {gameTitle(n.game) && <span class="badge">{gameTitle(n.game)}</span>}
            </div>
            <h2>{n.title[lang]}</h2>
            {n.text[lang].map((p) => <p>{p}</p>)}
            {n.game && (
              <a class="btn btn-fire" href={href(lang, `/games/${n.game}/`)}>{s.news.toGame} →</a>
            )}
          </div>
        </article>
      ))}
    </div>
  </section>
</Layout>

<style>
  .narrow {
    max-width: 820px;
  }

  .lead {
    color: var(--muted);
    font-size: 18px;
    margin-bottom: 32px;
  }

  .post {
    border-radius: calc(var(--radius) + 6px);
    overflow: hidden;
    background: var(--surface);
    box-shadow: inset 0 0 0 1px rgb(255 120 0 / 0.3);
    margin-bottom: 32px;
  }

  .post img {
    display: block;
    width: 100%;
    height: auto;
  }

  .body {
    padding: clamp(20px, 4vw, 36px);
  }

  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 14px;
    color: var(--muted);
    font-size: 14px;
  }

  h2 {
    margin: 14px 0 12px;
  }

  p {
    color: var(--muted);
    font-size: 17px;
  }

  .btn {
    margin-top: 12px;
  }
</style>
